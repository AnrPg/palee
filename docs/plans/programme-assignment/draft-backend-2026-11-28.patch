diff --git a/apps/api/lib/palee/application/programmes/assigning.ex b/apps/api/lib/palee/application/programmes/assigning.ex
new file mode 100644
index 0000000..e52e0b4
--- /dev/null
+++ b/apps/api/lib/palee/application/programmes/assigning.ex
@@ -0,0 +1,470 @@
+defmodule Palee.Application.Programmes.Assigning do
+  @moduledoc """
+  ADR-805: staff assign a training programme to a person from their profile
+  (or from the programme's page), like online programming but also for box
+  members. The person pays nothing; each training day uses one unit of their
+  subscription package (`ProgrammeDayCharge`): a class visit when the package
+  has classes, else an online-programming unit; nothing for personal
+  training or a gift.
+
+  An assigned programme is a `programme_purchases` row with `origin:
+  assigned`, so the days, «Έμεινε πίσω», «Κάν' τη σήμερα» and «Παράλειψη»
+  (ADR-540) work as for a bought one. Its days open one by one:
+
+    * a training day **opens** when its date comes (the hourly sweep, and at
+      once when it starts today): it takes one unit of the package
+      (reserved and consumed in Finance, idempotent per purchase and day)
+      and its WODs are assigned to the person on that date;
+    * with no unit left the day stays `waiting` («Χρειάζεται επίσκεψη»),
+      locked; it opens on the first sweep after the package has a unit
+      again (then it is today or behind). Nothing ever goes into debt. Days
+      open in order, so a later day never jumps a waiting one;
+    * a class the person booked that day already used a visit: the day
+      opens on that booking (`booking`) and uses no second visit;
+    * «Παράλειψη» on an opened day gives its unit back; catching up on a
+      behind day («Κάν' τη σήμερα») never charges it again.
+
+  `stop/3` (staff, or the person) ends it: the WODs after today go, the units
+  already used stay used, as for a class that took place.
+  """
+
+  require Logger
+
+  alias Palee.Application.AuthorizeClientAccess
+  alias Palee.Application.Programmes.{BuyerDays, Presenter, Studio}
+  alias Palee.Finance.Domain.ProgrammeDayCharge
+  alias Palee.{Finance, Identity, Notifications, Organizations, Programmes, Scheduling, Workouts}
+
+  @gift_capabilities [:take_payments, :manage_billing]
+
+  # ── Staff: what can be assigned, and the person's current one ───────────
+
+  @doc """
+  The profile card and the assign sheet for one person: the programmes
+  staff may assign, what each training day would use and how much the
+  package has left, and the person's active assigned programme.
+  """
+  def options(context, user_id) do
+    today = today(context)
+    entitlement = Finance.get_effective_entitlement(context, user_id)
+    charge = ProgrammeDayCharge.of(entitlement)
+
+    programmes =
+      context
+      |> Programmes.list_programmes(%{statuses: ["published"]})
+      |> Enum.filter(&Programmes.assignable?/1)
+      |> Enum.flat_map(fn programme ->
+        case Programmes.get_version(context, programme.current_version_id) do
+          %{} = version -> [option(programme, version, entitlement, charge)]
+          nil -> []
+        end
+      end)
+      |> Enum.sort_by(&String.downcase(&1.title || ""))
+
+    {:ok,
+     %{
+       programmes: programmes,
+       charge: elem_ok(charge),
+       charge_refused: if(match?({:error, _}, charge), do: to_string(elem(charge, 1))),
+       package_name: get_in(entitlement || %{}, [:subscription, :package_name]),
+       can_gift: can_gift?(context),
+       earliest_start: today,
+       latest_start: Date.add(today, 60),
+       current: current(context, user_id)
+     }}
+  end
+
+  defp option(programme, version, entitlement, charge) do
+    sessions = sessions(version)
+    allowance = with {:ok, charge} <- charge, do: ProgrammeDayCharge.allowance(charge)
+    allowance = if is_atom(allowance), do: allowance
+
+    %{
+      id: programme.id,
+      title: programme.title,
+      level: programme.level,
+      goal: programme.goal,
+      listing: programme.listing,
+      weeks: version.weeks,
+      sessions: sessions,
+      sessions_per_week: programme.sessions_per_week,
+      coverage: ProgrammeDayCharge.coverage(entitlement, allowance, sessions)
+    }
+  end
+
+  defp sessions(version), do: version.days |> Enum.map(& &1["day"]) |> Enum.uniq() |> length()
+
+  defp elem_ok({:ok, value}), do: value
+  defp elem_ok(_error), do: nil
+
+  defp current(context, user_id) do
+    case Programmes.active_assignment(context, user_id) do
+      nil -> nil
+      purchase -> summary(context, purchase)
+    end
+  end
+
+  @doc "One assigned programme as the profile card and the member card show it."
+  def summary(context, purchase) do
+    programme = Programmes.get_programme(context, purchase.programme_id)
+    version = Programmes.get_version(context, purchase.version_id)
+    charges = Programmes.day_charges(context, purchase.id)
+    days = if version, do: BuyerDays.present_for(context, purchase, version)
+
+    Presenter.purchase(purchase, %{
+      title: programme && programme.title,
+      weeks: version && version.weeks,
+      progress: days && days.progress,
+      behind: days && days.behind,
+      next_day: days && Enum.find(days.days, &(&1.status in ["today", "upcoming", "waiting"])),
+      used: Enum.count(charges, &(&1.kind in ["visit", "touchpoint"] and is_nil(&1.returned_at))),
+      assigned_by: name(purchase.assigned_by_id)
+    })
+  end
+
+  # ── Staff: assign and stop ──────────────────────────────────────────────
+
+  @doc """
+  Assigns programme `params.programme_id` to `user_id` from `starts_on`
+  (today up to 60 days ahead). `gift: true` uses nothing of the package and
+  needs payment rights. One active assigned programme per person.
+  """
+  def assign(context, user_id, params) do
+    now = DateTime.utc_now()
+    today = today(context, now)
+    starts_on = params[:starts_on] || today
+
+    with :ok <- AuthorizeClientAccess.call(context, :manage_coaching, user_id),
+         %{} = person <- Identity.find_by_id(user_id) || {:error, :not_found},
+         {:ok, programme} <- assignable(context, params[:programme_id]),
+         %{} = version <-
+           Programmes.get_version(context, programme.current_version_id) || {:error, :not_found},
+         :ok <- Programmes.check_start(starts_on, today),
+         {:ok, charge} <- charge(context, user_id, params[:gift] == true),
+         nil <- Programmes.active_assignment(context, user_id) || :ok,
+         {:ok, purchase} <-
+           Programmes.create_assignment(context, %{
+             programme_id: programme.id,
+             version_id: version.id,
+             user_id: person.id,
+             currency: programme.currency,
+             refund_policy: programme.refund_policy,
+             starts_on: starts_on,
+             ends_on: Programmes.ends_on(starts_on, version.weeks),
+             charge: charge,
+             assigned_by_id: context.user_id,
+             activated_at: now,
+             idempotency_key: key(params, programme.id, user_id, starts_on)
+           }) do
+      _opened = open_due(context, purchase, now)
+      notify(context, purchase, programme)
+
+      :telemetry.execute([:palee, :programmes, :assigned], %{count: 1}, %{
+        organization_id: context.organization_id,
+        id: purchase.id,
+        charge: charge
+      })
+
+      {:ok, summary(context, purchase)}
+    else
+      :ok -> {:error, :programme_already_assigned}
+      %{origin: "assigned"} -> {:error, :programme_already_assigned}
+      error -> error
+    end
+  end
+
+  defp assignable(context, id) do
+    case is_binary(id) && Programmes.get_programme(context, id) do
+      %{} = programme ->
+        if Programmes.assignable?(programme),
+          do: {:ok, programme},
+          else: {:error, :programme_not_assignable}
+
+      _missing ->
+        {:error, :not_found}
+    end
+  end
+
+  defp charge(context, _user_id, true) do
+    if can_gift?(context), do: {:ok, "none"}, else: {:error, :forbidden}
+  end
+
+  defp charge(context, user_id, false) do
+    context |> Finance.get_effective_entitlement(user_id) |> ProgrammeDayCharge.of()
+  end
+
+  defp can_gift?(context),
+    do: Enum.any?(@gift_capabilities, &(Organizations.capability_scope(context, &1) != nil))
+
+  defp key(params, programme_id, user_id, starts_on) do
+    case params[:idempotency_key] do
+      key when is_binary(key) and byte_size(key) in 8..180 -> "assign:" <> key
+      _none -> "assign:#{programme_id}:#{user_id}:#{starts_on}:#{Ecto.UUID.generate()}"
+    end
+  end
+
+  @doc """
+  Ends an assigned programme. `by: :staff` checks the actor coaches the
+  person; `by: :member` that it is the person's own. The WODs after today
+  go; the units already used stay used.
+  """
+  def stop(context, purchase_id, by: by) do
+    now = DateTime.utc_now()
+
+    with %{} = purchase <- Programmes.get_purchase(context, purchase_id) || {:error, :not_found},
+         true <- Programmes.assigned?(purchase) || {:error, :not_found},
+         :ok <- may_stop(context, purchase, by),
+         {:ok, purchase} <- Programmes.step_purchase(context, purchase.id, :stop, now),
+         :ok <- Studio.remove_future(context, purchase, now, :after_today) do
+      :telemetry.execute([:palee, :programmes, :stopped], %{count: 1}, %{
+        organization_id: context.organization_id,
+        id: purchase.id,
+        by: by
+      })
+
+      {:ok, summary(context, purchase)}
+    end
+  end
+
+  defp may_stop(context, purchase, :member),
+    do: if(purchase.user_id == context.user_id, do: :ok, else: {:error, :not_found})
+
+  defp may_stop(context, purchase, :staff),
+    do: AuthorizeClientAccess.call(context, :manage_coaching, purchase.user_id)
+
+  # ── Opening days ────────────────────────────────────────────────────────
+
+  @doc """
+  Opens the training days of an assigned programme whose date came, in
+  order, until one finds no unit: `{:ok, opened_count}`. Idempotent (the
+  Finance keys and the `(purchase, day)` row).
+  """
+  def open_due(context, purchase, now \\ DateTime.utc_now())
+
+  def open_due(context, %{origin: "assigned", status: "active"} = purchase, now) do
+    today = today(context, now)
+
+    with %{} = version <-
+           Programmes.get_version(context, purchase.version_id) || {:error, :not_found} do
+      context
+      |> BuyerDays.days_for(purchase, version, today)
+      |> Programmes.due_to_open()
+      |> Enum.reduce_while({:ok, 0}, fn row, {:ok, count} ->
+        case open_day(context, purchase, row, today) do
+          :ok -> {:cont, {:ok, count + 1}}
+          {:waiting, _reason} -> {:halt, {:ok, count}}
+          {:error, reason} -> {:halt, {:error, reason}}
+        end
+      end)
+    end
+  end
+
+  def open_due(_context, _purchase, _now), do: {:ok, 0}
+
+  defp open_day(context, purchase, row, today) do
+    with {:ok, kind, reservation_id} <- pay(context, purchase, row, today),
+         :ok <- deliver(context, purchase, row),
+         {:ok, _charge} <- record(context, purchase, row, today, kind, reservation_id) do
+      :ok
+    end
+  end
+
+  # A class booked that day already used a visit (ANR, 2026-11-28).
+  defp pay(context, %{charge: "class_visits"} = purchase, %{date: date} = row, today)
+       when date == today do
+    if booked_on?(context, purchase.user_id, today),
+      do: {:ok, "booking", nil},
+      else: reserve(context, purchase, row, today)
+  end
+
+  defp pay(context, %{charge: charge} = purchase, row, today)
+       when charge in ["class_visits", "coaching_touchpoints"],
+       do: reserve(context, purchase, row, today)
+
+  defp pay(_context, _purchase, _row, _today), do: {:ok, "none", nil}
+
+  defp reserve(context, purchase, row, today) do
+    request = ProgrammeDayCharge.request(purchase.charge, purchase.id, row.day, today)
+
+    with {:ok, %{id: id}} when is_binary(id) <-
+           Finance.reserve_entitlement(context, purchase.user_id, request),
+         {:ok, _finalized} <-
+           Finance.finalize_entitlement(context, id, %{
+             source_id: purchase.id,
+             reason: "Programme day opened",
+             idempotency_key: ProgrammeDayCharge.finalize_key(purchase.id, row.day),
+             metadata: %{"day" => row.day}
+           }) do
+      {:ok, ProgrammeDayCharge.kind(purchase.charge), id}
+    else
+      # Not metered (e.g. a lenient rollout mode): nothing was taken.
+      {:ok, %{id: nil}} -> {:ok, "none", nil}
+      {:error, reason, _details} -> {:waiting, reason}
+      {:error, reason} -> {:waiting, reason}
+    end
+  end
+
+  defp booked_on?(context, user_id, %Date{} = day) do
+    from = DateTime.new!(Date.add(day, -1), ~T[00:00:00], "Etc/UTC")
+
+    context
+    |> Scheduling.member_booking_times(user_id, from)
+    |> Enum.any?(&(Organizations.local_date(context, &1) == day))
+  rescue
+    _error -> false
+  end
+
+  defp deliver(context, purchase, row) do
+    row.workouts
+    |> Enum.reduce_while({:ok, []}, fn workout, {:ok, rows} ->
+      case Workouts.assign_workout(context, %{
+             master_workout_id: workout["workout_id"],
+             scheduled_for: row.date,
+             athlete_ids: [purchase.user_id]
+           }) do
+        {:ok, assignment} ->
+          {:cont,
+           {:ok, [%{assigned_workout_id: assignment.id, day: row.day, scheduled_for: row.date} | rows]}}
+
+        {:error, reason} ->
+          Logger.warning(
+            "assigned programme #{purchase.id}: day #{row.day} not assigned: #{inspect(reason)}"
+          )
+
+          {:halt, {:error, :programme_workout_unavailable}}
+      end
+    end)
+    |> case do
+      {:ok, rows} -> Programmes.record_deliveries(context, purchase.id, purchase.user_id, rows)
+      error -> error
+    end
+  end
+
+  defp record(context, purchase, row, today, kind, reservation_id) do
+    case Programmes.record_day_charge(context, %{
+           purchase_id: purchase.id,
+           user_id: purchase.user_id,
+           day: row.day,
+           charged_on: today,
+           kind: kind,
+           reservation_id: reservation_id
+         }) do
+      {:ok, charge} -> {:ok, charge}
+      # Opened by an overlapping run: the same reservation (same key).
+      {:error, %Ecto.Changeset{}} -> {:ok, :already_open}
+    end
+  end
+
+  @doc """
+  «Παράλειψη» on an opened day of an assigned programme gives its unit
+  back (the consumed reservation is reopened, then released). Idempotent.
+  """
+  def return_day(context, %{origin: "assigned"} = purchase, day) do
+    case Enum.find(Programmes.day_charges(context, purchase.id), &(&1.day == day)) do
+      %{reservation_id: id, returned_at: nil} = charge when is_binary(id) ->
+        allowance = ProgrammeDayCharge.allowance(purchase.charge)
+
+        with {:ok, _reopened} <-
+               Finance.reopen_entitlement_source(
+                 context,
+                 purchase.user_id,
+                 "programmes",
+                 purchase.id,
+                 allowance,
+                 %{idempotency_key: ProgrammeDayCharge.finalize_key(purchase.id, day)}
+               ),
+             {:ok, _released} <- release(context, id, purchase.id, day),
+             {:ok, _charge} <- Programmes.return_day_charge(context, charge, DateTime.utc_now()) do
+          :ok
+        end
+
+      _nothing_to_give_back ->
+        :ok
+    end
+  end
+
+  def return_day(_context, _purchase, _day), do: :ok
+
+  defp release(context, reservation_id, purchase_id, day) do
+    case Finance.release_entitlement(context, reservation_id, %{
+           reason: "Programme day skipped",
+           idempotency_key: ProgrammeDayCharge.release_key(purchase_id, day)
+         }) do
+      {:ok, entry} -> {:ok, entry}
+      {:error, :entitlement_reservation_already_closed} -> {:ok, :already_released}
+      error -> error
+    end
+  end
+
+  # ── Sweep ───────────────────────────────────────────────────────────────
+
+  @doc "The hourly sweep (ADR-371) opens due days of every active assigned programme."
+  def sweep(context, %DateTime{} = now) do
+    context
+    |> Programmes.list_active_assignments()
+    |> Enum.reduce(0, fn purchase, opened ->
+      case open_due(context, purchase, now) do
+        {:ok, count} ->
+          opened + count
+
+        {:error, reason} ->
+          Logger.warning("assigned programme #{purchase.id}: days not opened: #{inspect(reason)}")
+          opened
+      end
+    end)
+  end
+
+  @doc """
+  Whether a past-its-end assigned programme may complete: no day still
+  waits for a unit, or it reached the cap (ADR-540: its own length after
+  the planned end).
+  """
+  def completable?(context, %{origin: "assigned"} = purchase, %Date{} = today) do
+    case Programmes.get_version(context, purchase.version_id) do
+      %{} = version ->
+        waiting? =
+          context
+          |> BuyerDays.days_for(purchase, version, today)
+          |> Enum.any?(&(&1.status == "waiting"))
+
+        not waiting? or Date.compare(today, Programmes.latest_end(purchase, version.weeks)) == :gt
+
+      nil ->
+        true
+    end
+  end
+
+  def completable?(_context, _purchase, _today), do: true
+
+  # ── helpers ─────────────────────────────────────────────────────────────
+
+  defp notify(context, purchase, programme) do
+    box = Organizations.get_organization(context.organization_id)
+
+    Notifications.dispatch_event(:programme_assigned, %{
+      organization_id: context.organization_id,
+      user_id: purchase.user_id,
+      purchase_id: purchase.id,
+      programme_title: programme.title,
+      assigned_by: name(purchase.assigned_by_id) |> then(&(&1 && &1.nickname)),
+      box_name: box && box.name,
+      starts_on: Date.to_iso8601(purchase.starts_on)
+    })
+  rescue
+    error ->
+      Logger.warning("programme_assigned notification failed: #{Exception.message(error)}")
+      :ok
+  end
+
+  defp name(nil), do: nil
+
+  defp name(user_id) do
+    case Identity.find_by_id(user_id) do
+      %{id: id, nickname: nickname} -> %{id: id, nickname: nickname}
+      _missing -> nil
+    end
+  end
+
+  defp today(context, now \\ DateTime.utc_now()),
+    do: Organizations.local_today(context.organization_id, now)
+end
diff --git a/apps/api/lib/palee/finance/domain/programme_day_charge.ex b/apps/api/lib/palee/finance/domain/programme_day_charge.ex
new file mode 100644
index 0000000..922c497
--- /dev/null
+++ b/apps/api/lib/palee/finance/domain/programme_day_charge.ex
@@ -0,0 +1,119 @@
+defmodule Palee.Finance.Domain.ProgrammeDayCharge do
+  @moduledoc """
+  ADR-805: what one training day of a programme staff assign uses from the
+  person's subscription package, pure.
+
+  ANR (2026-11-28): an assigned programme is like online programming, also
+  for box members, and each training day uses a **class visit**
+  («επίσκεψη»), not an online-programming unit. In order:
+
+    * `"class_visits"`: the package includes group classes (`in_person` +
+      `book_classes`); each day uses one of the package's general visits
+      (never a class type's own limit);
+    * `"coaching_touchpoints"`: no classes, but online programming
+      (ADR-225): each day uses one online-programming unit, as a WOD sent to
+      the person does;
+    * `"none"`: personal training only (the programme is part of the PT
+      service, as ADR-225 meters nothing for it), or a gift staff chose.
+
+  Anything else: `{:error, :programme_charge_not_in_package}`.
+  """
+
+  alias Palee.Finance.Domain.{EntitlementPolicy, ProgrammingGrant}
+
+  @classes %{channel: :in_person, capability: :book_classes}
+
+  @doc "`{:ok, charge}` for the person's effective entitlement, or the refusal."
+  def of(entitlement) do
+    if EntitlementPolicy.authorize_explicit(entitlement, @classes) == :ok,
+      do: {:ok, "class_visits"},
+      else: without_classes(entitlement)
+  end
+
+  defp without_classes(entitlement) do
+    case ProgrammingGrant.of(entitlement) do
+      {:ok, :online_programming} -> {:ok, "coaching_touchpoints"}
+      {:ok, :personal_training} -> {:ok, "none"}
+      {:error, _reason} -> {:error, :programme_charge_not_in_package}
+    end
+  end
+
+  @doc "The allowance key a charge uses (`nil` for `none`)."
+  def allowance("class_visits"), do: :class_visits
+  def allowance("coaching_touchpoints"), do: :coaching_touchpoints
+  def allowance(_charge), do: nil
+
+  @doc "The `programme_day_charges.kind` a paid day records."
+  def kind("class_visits"), do: "visit"
+  def kind("coaching_touchpoints"), do: "touchpoint"
+  def kind(_charge), do: "none"
+
+  @doc """
+  The Finance reservation request for one day, charged on `today` (a day
+  that waited for a visit is paid from the period it opens in).
+  """
+  def request("class_visits", purchase_id, day, %Date{} = today),
+    do:
+      base(purchase_id, day, today, %{
+        channel: :in_person,
+        capability: :book_classes,
+        allowance: :class_visits
+      })
+
+  def request("coaching_touchpoints", purchase_id, day, %Date{} = today),
+    do:
+      base(purchase_id, day, today, %{
+        channel: :personal_programming,
+        capability: :receive_coaching_touchpoints,
+        allowance: :coaching_touchpoints
+      })
+
+  defp base(purchase_id, day, today, request) do
+    Map.merge(request, %{
+      quantity: 1,
+      occurred_on: today,
+      source_context: "programmes",
+      source_id: purchase_id,
+      idempotency_key: "programme-day:#{purchase_id}:#{day}",
+      metadata: %{"kind" => "programme_day", "day" => day}
+    })
+  end
+
+  @doc "The idempotency key of the finalize that consumes a day's reservation."
+  def finalize_key(purchase_id, day), do: "programme-day-finalize:#{purchase_id}:#{day}"
+
+  @doc "The idempotency key of the release that gives a skipped day's unit back."
+  def release_key(purchase_id, day), do: "programme-day-release:#{purchase_id}:#{day}"
+
+  @doc """
+  What the assign sheet says the programme will use, from the effective
+  entitlement's allowance (`%{limit, remaining, period_end}`): `sessions`
+  training days against what is left until the period ends. `nil` when the
+  charge meters nothing.
+  """
+  def coverage(nil, _allowance, _sessions), do: nil
+  def coverage(_entitlement, nil, _sessions), do: nil
+
+  def coverage(entitlement, allowance, sessions) when is_integer(sessions) do
+    allowances = Map.get(entitlement || %{}, :allowances) || %{}
+
+    case Map.get(allowances, allowance) || Map.get(allowances, to_string(allowance)) do
+      %{remaining: :unlimited} = state ->
+        %{unlimited: true, remaining: nil, covered: sessions, period_end: state[:period_end]}
+
+      %{limit: :unlimited} = state ->
+        %{unlimited: true, remaining: nil, covered: sessions, period_end: state[:period_end]}
+
+      %{remaining: remaining} = state when is_integer(remaining) ->
+        %{
+          unlimited: false,
+          remaining: remaining,
+          covered: min(remaining, sessions),
+          period_end: state[:period_end]
+        }
+
+      _none ->
+        %{unlimited: false, remaining: 0, covered: 0, period_end: nil}
+    end
+  end
+end
