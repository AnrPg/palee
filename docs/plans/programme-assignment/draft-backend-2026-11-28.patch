+defmodule Palee.Programmes.ProgrammeDayCharge do
+  @moduledoc """
+  ADR-805: one opened training day of an assigned programme and how it was
+  paid: `visit` (a visit of the package), `touchpoint` (an online
+  programming unit), `booking` (a class booked that day already used a
+  visit) or `none` (a gift, or personal training). `reservation_id` is the
+  Finance usage entry it took; `returned_at` is set when «Παράλειψη» gave
+  it back.
+  """
+
+  use Ecto.Schema
+  import Ecto.Changeset
+
+  @primary_key {:id, :binary_id, autogenerate: true}
+  @foreign_key_type :binary_id
+
+  @kinds ~w(visit touchpoint booking none)
+
+  schema "programme_day_charges" do
+    field :organization_id, :binary_id, read_after_writes: true
+    field :purchase_id, :binary_id
+    field :user_id, :binary_id
+    field :day, :integer
+    field :charged_on, :date
+    field :kind, :string
+    field :reservation_id, :binary_id
+    field :returned_at, :utc_datetime_usec
+
+    timestamps(type: :utc_datetime_usec)
+  end
+
+  def kinds, do: @kinds
+
+  def changeset(attrs) do
+    %__MODULE__{}
+    |> cast(attrs, [
+      :organization_id,
+      :purchase_id,
+      :user_id,
+      :day,
+      :charged_on,
+      :kind,
+      :reservation_id
+    ])
+    |> validate_required([:purchase_id, :user_id, :day, :charged_on, :kind])
+    |> validate_inclusion(:kind, @kinds)
+    |> unique_constraint([:purchase_id, :day])
+    |> check_constraint(:kind, name: :programme_day_charges_check)
+  end
+
+  def returned_changeset(charge, %DateTime{} = at), do: change(charge, returned_at: at)
+end
