+  @doc """
+  ADR-805: a programme staff assign to a person. It starts active (nothing
+  to pay); `charge` says what each training day uses.
+  """
+  def assign_changeset(attrs) do
+    %__MODULE__{}
+    |> cast(attrs, [
+      :organization_id,
+      :programme_id,
+      :version_id,
+      :user_id,
+      :currency,
+      :refund_policy,
+      :starts_on,
+      :ends_on,
+      :charge,
+      :assigned_by_id,
+      :activated_at,
+      :idempotency_key
+    ])
+    |> validate_required([
+      :programme_id,
+      :version_id,
+      :user_id,
+      :currency,
+      :refund_policy,
+      :starts_on,
+      :ends_on,
+      :charge,
+      :activated_at,
+      :idempotency_key
