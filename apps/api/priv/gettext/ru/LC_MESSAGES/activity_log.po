# ADR-760 (ANR 12B): the owners' morning summary of yesterday's sensitive actions.
msgid "%{box}: %{count} sensitive action yesterday"
msgid_plural "%{box}: %{count} sensitive actions yesterday"
msgstr[0] "%{box}: вчера %{count} важное действие"
msgstr[1] "%{box}: вчера %{count} важных действия"
msgstr[2] "%{box}: вчера %{count} важных действий"

# One line per kind of action: «Πιστωτικά: 2».
msgid "%{label}: %{count}"
msgstr "%{label}: %{count}"

# The email's first line.
msgid "What your staff did at %{box} yesterday, %{date}, that the activity log marks as sensitive:"
msgstr "Что ваши сотрудники сделали вчера, %{date}, в %{box} и что журнал действий отмечает как важное:"

# The email's button.
msgid "Open the activity log"
msgstr "Открыть журнал действий"

# The email's footer.
msgid "You get this email because you are an owner of %{box} on Palee."
msgstr "Вы получаете это письмо, потому что вы владелец %{box} в Palee."

# Kinds without their own words yet.
msgid "Other sensitive actions"
msgstr "Другие важные действия"

# Kind `member.remove`.
msgid "Box members removed"
msgstr "Удалённые участники бокса"

# Kind `member.role_change`.
msgid "Role changes"
msgstr "Смены ролей"

# Kind `member.status_set`.
msgid "Statuses set by hand"
msgstr "Статусы, заданные вручную"

# Kind `member.status_reset`.
msgid "Statuses back to automatic"
msgstr "Статусы, возвращённые в автоматический режим"

# Kind `role_access.change`.
msgid "Role permission changes"
msgstr "Изменения прав ролей"

# Kind `import.apply`.
msgid "Imports applied"
msgstr "Применённые импорты"

# Kind `import.undo`.
msgid "Imports undone"
msgstr "Отменённые импорты"

# Kind `payment.reverse`.
msgid "Payments reversed"
msgstr "Сторнированные платежи"

# Kind `payment.refund`.
msgid "Refunds"
msgstr "Возвраты денег"

# Kind `payment.charge_dismiss`.
msgid "Failed charges closed"
msgstr "Закрытые неудачные списания"

# Kind `payment_account.save`.
msgid "Payment account changes"
msgstr "Изменения платёжного аккаунта"

