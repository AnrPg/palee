msgstr "Абонементы, активированные до оплаты"

# Kind `door.unlock`.
msgid "Doors opened remotely"
msgstr "Двери, открытые удалённо"

# Kind `shop.order_refund`.
msgid "Shop order refunds"
msgstr "Возвраты по заказам магазина"

# Kind `programme.refund`.
msgid "Programme refunds"
msgstr "Возвраты за программы"

# Kind `pay_period.reopen`.
msgid "Pay periods reopened"
msgstr "Повторно открытые периоды выплат"

# Kind `organization.transfer`.
msgid "Ownership transfers"
msgstr "Передачи владения"

# Kind `organization.archive`.
msgid "Box archived"
