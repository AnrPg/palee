msgid "Review reports waiting: %{count}"
msgstr "Αναφορές κριτικών σε αναμονή: %{count}"

msgid "Open the queue"
msgstr "Άνοιξε την ουρά"

msgid "%{reviews} reviews with %{reports} reports wait for a decision, the oldest since %{date}. Until you decide, they stay up."
msgstr "%{reviews} κριτικές με %{reports} αναφορές περιμένουν απόφαση, η παλαιότερη από %{date}. Μέχρι να αποφασίσετε, μένουν δημοσιευμένες."

msgid "You get this email because you moderate box reviews for Palee."
msgstr "Λαμβάνεις αυτό το email επειδή ελέγχεις κριτικές box για την Palee."
