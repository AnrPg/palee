# ADR-760 (ANR 12B): the owners' morning summary of yesterday's sensitive actions.
msgid "%{box}: %{count} sensitive action yesterday"
msgid_plural "%{box}: %{count} sensitive actions yesterday"
msgstr[0] "%{box}: %{count} acción sensible ayer"
msgstr[1] "%{box}: %{count} acciones sensibles ayer"

# One line per kind of action: «Πιστωτικά: 2».
msgid "%{label}: %{count}"
msgstr "%{label}: %{count}"

# The email's first line.
msgid "What your staff did at %{box} yesterday, %{date}, that the activity log marks as sensitive:"
msgstr "Lo que tu equipo hizo ayer, %{date}, en %{box} y que el registro de actividad marca como sensible:"

# The email's button.
msgid "Open the activity log"
msgstr "Abrir el registro de actividad"

# The email's footer.
msgid "You get this email because you are an owner of %{box} on Palee."
msgstr "Recibes este correo porque eres propietario de %{box} en Palee."

# Kinds without their own words yet.
msgid "Other sensitive actions"
msgstr "Otras acciones sensibles"

# Kind `member.remove`.
msgid "Box members removed"
msgstr "Miembros del box dados de baja"

# Kind `member.role_change`.
msgid "Role changes"
msgstr "Cambios de rol"

